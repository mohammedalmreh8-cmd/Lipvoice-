# Supabase project credentials for LipVoice (frontend).
# Copy this file to ".env" and fill in the values from
# Supabase Dashboard -> Project Settings -> API.
#
# The anon key is designed to be public: it runs in the browser and is
# protected by Row Level Security. Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
